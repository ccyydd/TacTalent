# Set these in your local shell; never commit real credentials.
ASTRA_API_KEY=
ASTRA_API_ENDPOINT=https://api.example.com/v1/responses
ASTRA_OPENVITAC_ROOT=/opt/tactalent/benchmarks/OpenViTac
ASTRA_UNIVTAC_ROOT=/opt/tactalent/benchmarks/UniVTAC
ASTRA_UNIVTAC_TRAIN_CAMERA_ROOT=/opt/tactalent/benchmarks/UniVTAC-training-source
# Offline demonstration preparation (training-config creates this YAML).
# ASTRA_UNIVTAC_SOURCE_CONFIG=/opt/tactalent/inputs/univtac_training.yaml
# Optional robot/assets overrides; otherwise derived from the benchmark roots.
# ASTRA_UNIVTAC_URDF=/opt/tactalent/benchmarks/UniVTAC/assets/embodiments/franka/panda.urdf
# ASTRA_UNIVTAC_TACEX_ASSETS=/opt/tactalent/benchmarks/UniVTAC-training-source/third_party/TacEx/source/tacex_assets/tacex_assets
# Optional reference catalog override; otherwise references/<icl-mode>/catalog.json.
# ASTRA_REFERENCE_CATALOG=/opt/tactalent/outputs/references/vision_tactile/catalog.json
# Optional: active-environment Python, additional cuRobo/TacEx paths, output root.
# ASTRA_PYTHON=python
# ASTRA_EXTRA_PYTHONPATH=/opt/tactalent/dependencies/curobo/src
# ASTRA_STORAGE_ROOT=/opt/tactalent/outputs
# ASTRA_API_PROXY_URL=http://127.0.0.1:18790
